{
  "name": "@zerobias-org/suite-{vendor}-{code}",
  "version": "1.0.0",
  "description": "{name}",
  "author": "team@zerobias.com",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/suite.git",
    "directory": "package/{vendor}/{code}/"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org"
  },
  "files": [
    "index.yml",
    "logo.*",
    "npm-shrinkwrap.json"
  ],
  "dependencies": {
    "@zerobias-org/vendor-{vendor}": "*"
  },
  "zerobias": {
    "dataloader-version": "1.0.0",
    "import-artifact": "suite",
    "package": "{vendor}.{code}"
  }
}
